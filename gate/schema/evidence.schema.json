{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/trust-supply-chain/security-evidence.schema.json",
  "title": "SecurityEvidence",
  "type": "object",
  "required": ["apiVersion", "kind", "image", "scan", "vex"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "trust-supply-chain.poc/v1"
    },
    "kind": {
      "const": "SecurityEvidence"
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "scan": {
      "type": "object",
      "required": ["source", "critical_cves", "total_vulnerabilities"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "acs"
        },
        "critical_cves": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CVE-[0-9]{4}-[0-9]+$"
          },
          "uniqueItems": true
        },
        "total_vulnerabilities": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "vex": {
      "type": "object",
      "required": ["source", "advisories", "known_not_affected"],
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "trustify"
        },
        "advisories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "known_not_affected": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CVE-[0-9]{4}-[0-9]+$"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
